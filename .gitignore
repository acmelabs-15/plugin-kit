# Dependencies
node_modules/

# Bun
.bun/
*.bun-build

# Build and packaging output
dist/
build/
*.skill

# Scratch workspaces from older eval runs. Durable eval evidence now lives in
# evals/results/ and IS committed: transcripts and benchmarks are the evidence behind
# the skill's own measured claims, and a number nobody can re-derive is not evidence.
*-workspace/

# Fixture repositories copied into a run. Reproducible from evals/fixtures/, and each
# carries its own .git, so committing one nests a repository inside this one.
evals/results/**/repo/

# Test and coverage output
coverage/
*.lcov

# Local, machine-specific config
.env
.env.*
!.env.example
.claude/*.local.md
.claude/settings.local.json

# Editors
.vscode/
.idea/
*.swp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
