{
  "description": "Protects release branches from force pushes, and tells Claude where the repository stands at session start.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/handlers/guard-push.ts"],
            "if": "Bash(git push *)",
            "timeout": 10,
            "statusMessage": "Checking the push target"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/handlers/tidy-edit.ts"],
            "if": "Edit(**/*.ts)",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/handlers/session-context.ts"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
